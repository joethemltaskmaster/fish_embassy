# ─── Local Development Settings ─────────────────────────────
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ─── Render Production Settings ─────────────────────────────
# On Render, DJANGO_DEBUG should be 0, and SECRET_KEY should be generated.
# ALLOWED_HOSTS should include your .onrender.com domain.
# CSRF_TRUSTED_ORIGINS should include https://*.onrender.com

# ─── Database Configuration ─────────────────────────────────
# Locally, we use individual vars:
POSTGRES_DB=rao
POSTGRES_USER=rao
POSTGRES_PASSWORD=rao
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# On Render, you will provide ONLY this DATABASE_URL, 
# and the settings will automatically prefer it over the POSTGRES_* vars.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── AI Integration ─────────────────────────────────────────
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE